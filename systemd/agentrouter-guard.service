[Unit]
Description=Restore agentrouter.org compatibility layers if an update wiped them
After=graphical-session.target

[Service]
Type=oneshot
# rewritten by install.sh to the absolute product path
ExecStart=__PRODUCT_ROOT__/scripts/agentrouter-guard.sh
# Guard must never fail loudly into the user session; it logs to guard.log
SuccessExitStatus=0 1
