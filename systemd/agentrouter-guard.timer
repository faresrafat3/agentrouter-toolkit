[Unit]
Description=Run agentrouter layers guard periodically and at login

[Timer]
# Every 10 minutes
OnCalendar=*-*-* *:00/10:00
# Also once shortly after login/boot (catches desktop-app-triggered updates)
OnBootSec=90
OnStartupSec=90
Persistent=true
Unit=agentrouter-guard.service

[Install]
WantedBy=timers.target
